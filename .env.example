# Copy to .env (ignored by git) and change the value. Local development only.
# The owner's password, known only to the step that applies the migrations.
TURNO_DB_PASSWORD=change-me-local-only
# The password of the restricted role the service connects with. No single quotes.
TURNO_DB_APP_PASSWORD=change-me-app-local-only

# API tokens: at least 32 characters, and different from each other.
TURNO_API_TOKEN_AGENTS=local-only-agents-token-change-me-0001
TURNO_API_TOKEN_STAFF=local-only-staff-token-change-me-00002
TURNO_API_TOKEN_WORKFLOWS=local-only-workflows-token-change-me-03

# Optional: which file of config/tenants/ to serve.
# TURNO_TENANT=mirador-dental

# Optional: host ports, bound to 127.0.0.1.
# TURNO_CORE_PORT=8080
# TURNO_AGENTS_PORT=8000
